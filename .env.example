# Example environment variables for local development
# Copy to .env and fill real secrets (do NOT commit .env to the repo)

# Database
DB_NAME=oficina_db
DB_USER=oficinampl
DB_PASSWORD=***REDACTED***
DB_PORT=5432

# Spring
SPRING_PROFILE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# JWT (dev only) - override in real envs
JWT_SECRET=***REDACTED***
JWT_EXPIRATION=3600

# ----------------------------------------------------------------------------
# E-mail (notificações de mudança de status da ordem de serviço)
#
# Padrão de desenvolvimento: MailHog do docker-compose (nada sai para a internet).
# Veja os e-mails capturados em http://localhost:8025
#
# Para um SMTP real, sobrescreva as variáveis abaixo — nenhuma mudança de código:
#   Gmail : MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SMTP_AUTH=true  MAIL_SMTP_STARTTLS=true
#           MAIL_USERNAME=<sua conta>  MAIL_PASSWORD=<app password, com 2FA ativo>
#   AWS SES: MAIL_HOST=email-smtp.<região>.amazonaws.com  MAIL_PORT=587  MAIL_SMTP_AUTH=true
#           MAIL_SMTP_STARTTLS=true  (credenciais SMTP do IAM, remetente verificado)
#
# NOTIFICATIONS_EMAIL_ENABLED=false desliga o envio: o e-mail só vai para o log.
# ----------------------------------------------------------------------------
MAIL_PORT=1025
MAIL_UI_PORT=8025
MAIL_USERNAME=
MAIL_PASSWORD=***REDACTED***
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_EMAIL_FROM=nao-responda@oficina.local

